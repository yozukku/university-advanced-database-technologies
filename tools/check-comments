#!/usr/bin/env python3

import re
import subprocess
import sys
import tokenize
from pathlib import Path

AUTHOR = "/** @author Anton Gorokh */"
SQL_TOKENS = re.compile(
    r"(?P<comment>--[^\n]*|/\*.*?\*/)"
    r"|(?P<dollar>\$(?:[A-Za-z_]\w*)?\$).*?(?P=dollar)"
    r"|[eE]'(?:\\.|''|[^'\\])*'|'(?:''|[^'])*'|\"(?:\"\"|[^\"])*\"",
    re.DOTALL,
)
C_STYLE_TOKENS = re.compile(
    r"(?P<comment>//[^\n]*|/\*.*?\*/)"
    r'|""".*?"""|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|`(?:\\.|[^`\\])*`',
    re.DOTALL,
)
JAVA_TYPE = re.compile(
    r"\s*(?:(?:@[\w.]+(?:\([^;]*?\))?|public|protected|private|static|abstract|final|sealed|non-sealed)\s+)*"
    r"(?:class|interface|enum|record)\s+\w+"
)
SOURCE_SUFFIXES = {".py", ".java", ".ts", ".tsx", ".sql"}


def comment_lines(path):
    if path.suffix == ".py":
        with tokenize.open(path) as source:
            for token in tokenize.generate_tokens(source.readline):
                if token.type == tokenize.COMMENT:
                    if token.start == (1, 0) and token.string.startswith("#!"):
                        continue
                    yield token.start[0]
        return

    source = path.read_text()
    pattern = SQL_TOKENS if path.suffix == ".sql" else C_STYLE_TOKENS
    for token in pattern.finditer(source):
        if token.lastgroup != "comment":
            continue
        if path.suffix == ".java" and token.group() == AUTHOR:
            if JAVA_TYPE.match(source, token.end()):
                continue
        yield source.count("\n", 0, token.start()) + 1


def main():
    root = Path(__file__).resolve().parent.parent
    entries = subprocess.check_output(
        ["git", "-C", str(root), "ls-files", "-z", "--cached", "--others", "--exclude-standard"]
    ).split(b"\0")
    paths = [Path(arg) for arg in sys.argv[1:]] or [root / item.decode() for item in entries if item]
    failed = False
    for path in sorted(set(paths)):
        if path.suffix not in SOURCE_SUFFIXES or not path.is_file():
            continue
        try:
            for line in comment_lines(path):
                print(f"{path}:{line}: niedozwolony komentarz", file=sys.stderr)
                failed = True
        except (SyntaxError, tokenize.TokenError) as error:
            print(f"{path}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
