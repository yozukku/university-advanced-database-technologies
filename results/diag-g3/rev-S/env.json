        "settings": {
          "docker/conf/mongo/mongod.yaml": "net:\n  bindIpAll: true\nstorage:\n  dbPath: /data/db\n  wiredTiger:\n    engineConfig:\n      cacheSizeGB: 4\nreplication:\n  replSetName: rs0\n  oplogSizeMB: 1024\nsetParameter:\n  transactionLifetimeLimitSeconds: 600\n",
          "docker/conf/mongo/ready.js": "const hello = db.adminCommand({ hello: 1 });\n\nif (hello.isreplicaset) {\n    const initialized = rs.initiate({ _id: \"rs0\", members: [{ _id: 0, host: \"mongo:27017\" }] });\n    if (initialized.ok !== 1) {\n        printjson(initialized);\n    }\n    quit(1);\n}\n\nif (!hello.isWritablePrimary) {\n    quit(1);\n}\n\nconst defaults = db.adminCommand({ getDefaultRWConcern: 1 });\nif (defaults.ok !== 1) {\n    quit(1);\n}\n\nif (defaults.defaultWriteConcern?.w !== 1 || defaults.defaultWriteConcern?.j !== true) {\n    const changed = db.adminCommand({\n        setDefaultRWConcern: 1,\n        defaultWriteConcern: { w: 1, j: true },\n    });\n    quit(changed.ok === 1 ? 0 : 1);\n}\n"
        }
